# ============================================================
# MIAD Market — backend sans WordPress
# Copier en .env puis compléter. Jamais de secret en clair ici
# dans le dépôt.
# ============================================================

# ---- Postgres (un conteneur, sept bases créées par deploy/init-db.sh)
POSTGRES_PASSWORD=change-me-fort
PGHOST=postgres
PGPORT=5432
PGUSER=miad

# DSN par service (base dédiée, jamais partagée)
DATABASE_URL_CATALOG=postgres://miad:change-me-fort@postgres:5432/miad_catalog?sslmode=disable
DATABASE_URL_VENDOR=postgres://miad:change-me-fort@postgres:5432/miad_vendor?sslmode=disable
DATABASE_URL_ORDER=postgres://miad:change-me-fort@postgres:5432/miad_order?sslmode=disable
DATABASE_URL_PAYMENT=postgres://miad:change-me-fort@postgres:5432/miad_payment?sslmode=disable
DATABASE_URL_SHIPPING=postgres://miad:change-me-fort@postgres:5432/miad_shipping?sslmode=disable
DATABASE_URL_AUTH=postgres://miad:change-me-fort@postgres:5432/miad_auth?sslmode=disable
DATABASE_URL_NOTIFICATION=postgres://miad:change-me-fort@postgres:5432/miad_notification?sslmode=disable
DATABASE_URL_EMAIL=postgres://miad:change-me-fort@postgres:5432/miad_email?sslmode=disable

# ---- Redis (cache + sessions)
REDIS_ADDR=redis:6379
REDIS_PASSWORD=

# ---- Kafka (KRaft single-node en local ; Upstash en prod légère)
KAFKA_BROKERS=kafka:9092

# ---- Services (ports internes au réseau docker)
PORT_CATALOG=8081
PORT_VENDOR=8082
PORT_ORDER=8083
PORT_PAYMENT=8084
PORT_SHIPPING=8085
PORT_AUTH=8086
PORT_NOTIFICATION=8087
PORT_EMAIL=8089

# ---- URLs inter-services (admin-svc + vendor-svc en ont besoin pour agréger)
CATALOG_SVC_URL=http://catalog-svc:8081
VENDOR_SVC_URL=http://vendor-svc:8082
ORDER_SVC_URL=http://order-svc:8083
PAYMENT_SVC_URL=http://payment-svc:8084
SHIPPING_SVC_URL=http://shipping-svc:8085
AUTH_SVC_URL=http://auth-svc:8086
NOTIFICATION_SVC_URL=http://notification-svc:8087
EMAIL_SVC_URL=http://email-svc:8089

# ---- Secrets applicatifs
JWT_SECRET=change-me-64-octets-aleatoires
JWT_TTL_HOURS=72
OTP_TTL_MINUTES=5
PAYMENT_TIMEOUT_MINUTES=30

# ---- Paiement
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
PAYDUNYA_API_KEY_PUBLIC=
PAYDUNYA_API_KEY_PRIVATE=
PAYDUNYA_MASTER_KEY=
PAYDUNYA_API_BASE=https://app.paydunya.com

# ---- OTP (si vide : le code est journalisé — dev uniquement)
SMS_PROVIDER_URL=
SMS_PROVIDER_TOKEN=

# ---- Admin (console /admin)
ADMIN_EMAIL=admin@miadmarket.ca
ADMIN_PASSWORD=change-moi-fort
PORT_ADMIN=8088
ADMIN_SVC_URL=http://admin-svc:8088

# ---- Email (Resend + configuration)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx  # Obtenir sur https://resend.com
FROM_EMAIL=noreply@miadmarket.ca
# Pour recevoir les emails : configurer le domaine dans Resend et pointer vers /webhooks/inbound

# ---- Firebase (login Google de la console admin)
FIREBASE_WEB_CLIENT_ID=

# ---- URLs de rappel paiement / frontend
STOREFRONT_URL=https://miadmarket.ca

# ---- Import WooCommerce (make import)
WC_URL=https://api.miadmarket.ca
WC_KEY=ck_...
WC_SECRET=cs_...
