# Dependencies
# Ancré à la racine (/vendor/) : sans le slash de tête, ce motif capturait
# aussi frontend/app/api/vendor/ (dossier de routes Next.js, pas le vendor/
# Go) — tout ce dossier était invisible pour git, découvert le 2026-08-24.
/vendor/
node_modules/

# Build React (admin-svc/webui) — généré par npm run build, embarqué
# via go:embed au moment du build Docker (voir Dockerfile stage "webui")
services/admin-svc/webui/dist/

# Compiled and build artifacts
*.o
*.obj
*.a
*.so
*.dll
*.exe
*.out

# Go-specific
*.test
*.prof

# Logs and temp files
*.log
*.tmp
*.swp

# Editors
.vscode/
.idea/

# Environment
.env
.env.local
*.env.*
