# ============================================================
# Passerelle externe — remplace l'URL WooCommerce côté frontend.
# Les routes Next.js app/api/* pointent ici ; le contrat JSON
# reste identique (généré à terme par grpc-gateway).
#
# Trois domaines nommés, HTTPS automatique (Let's Encrypt, géré par
# Caddy — nécessite les ports 80 ET 443 ouverts sur le VPS, et les
# enregistrements DNS déjà pointés vers l'IP du VPS avant le premier
# démarrage, sinon la validation ACME échoue) :
#   - origin.miadmarket.ca → toute l'API backend (bloc api_routes)
#   - kante.miadmarket.ca  → même VPS, uniquement le dashboard /admin
#   - img.miadmarket.ca    → même VPS, images produits/vendeurs (MinIO)
#
# Format multi-lignes obligatoire pour chaque bloc `handle { … }` —
# la syntaxe one-liner `handle /path { directive }` est rejetée par
# les versions récentes de Caddy 2 ("Unexpected next token after '{'
# on same line"), confirmé le 2026-08-24 sur caddy:2-alpine.
# ============================================================
{
	admin off
	email admin@miadmarket.ca
}

# ---------- Snippet réutilisable : toutes les routes API ----------
(api_routes) {
	encode zstd gzip

	# Catalogue — catalog-svc
	handle_path /catalog/* {
		reverse_proxy catalog-svc:8081
	}
	handle /products* {
		reverse_proxy catalog-svc:8081
	}
	handle /categories* {
		reverse_proxy catalog-svc:8081
	}
	handle /search/* {
		reverse_proxy catalog-svc:8081
	}

	# Boutiques & vendeurs — vendor-svc
	handle /stores* {
		reverse_proxy vendor-svc:8082
	}
	handle /vendor/* {
		reverse_proxy vendor-svc:8082
	}

	# Commandes — order-svc
	handle /orders* {
		reverse_proxy order-svc:8083
	}

	# Paiement (webhooks Stripe/PayDunya inclus) — payment-svc
	handle /payments/* {
		reverse_proxy payment-svc:8084
	}

	# Livraison — shipping-svc (zone internationale + national Sénégal)
	handle /shipping-rates* {
		reverse_proxy shipping-svc:8085
	}
	handle /shipping-domestic/* {
		reverse_proxy shipping-svc:8085
	}
	handle /vendor-shipping-address {
		reverse_proxy shipping-svc:8085
	}
	handle /exchange-rates {
		reverse_proxy shipping-svc:8085
	}

	# Compte & auth — auth-svc
	handle /auth/* {
		reverse_proxy auth-svc:8086
	}
	handle /customer* {
		reverse_proxy auth-svc:8086
	}

	# Console d'administration (interface + API) — admin-svc
	handle /admin* {
		reverse_proxy admin-svc:8088
	}

	# Notifications (Kafka consumer, stats en lecture) + push FCM — notification-svc
	handle /notifications* {
		reverse_proxy notification-svc:8087
	}
	handle /push/* {
		reverse_proxy notification-svc:8087
	}

	# Emails transactionnels + webhooks entrants (Resend) — email-svc
	handle /emails* {
		reverse_proxy email-svc:8089
	}
	handle /webhooks/* {
		reverse_proxy email-svc:8089
	}

	# Tracking unifié + DHL — fulfillment-svc
	handle /shipments* {
		reverse_proxy fulfillment-svc:8090
	}
	handle /tracking/* {
		reverse_proxy fulfillment-svc:8090
	}
	handle /dhl/* {
		reverse_proxy fulfillment-svc:8090
	}

	# Coins/fidélité + représentants pays — loyalty-svc
	handle /coins* {
		reverse_proxy loyalty-svc:8091
	}
	handle /coupons* {
		reverse_proxy loyalty-svc:8091
	}
	handle /representative* {
		reverse_proxy loyalty-svc:8091
	}

	handle {
		respond 404 {
			body "{\"error\":{\"code\":\"not_found\",\"message\":\"route inconnue sur la passerelle\"}}"
		}
	}
}

# ---------- origin.miadmarket.ca : API backend complète ----------
origin.miadmarket.ca {
	import api_routes
}

# ---------- kante.miadmarket.ca : dashboard admin uniquement ----------
kante.miadmarket.ca {
	redir / /admin/ 302
	handle /admin* {
		reverse_proxy admin-svc:8088
	}
	handle {
		respond 404 {
			body "{\"error\":{\"code\":\"not_found\",\"message\":\"route inconnue — ce domaine ne sert que /admin\"}}"
		}
	}
}

# ---------- img.miadmarket.ca : images produits/vendeurs (MinIO) ----------
# Bucket "miad-media" public en lecture seule anonyme (écriture protégée
# par les credentials MinIO, jamais exposées côté client). rewrite ajoute
# le préfixe du bucket : img.miadmarket.ca/x.jpg → minio:9000/miad-media/x.jpg
img.miadmarket.ca {
	handle {
		reverse_proxy minio:9000 {
			rewrite /miad-media{uri}
		}
	}
}

# ---------- Repli : IP directe / nom d'hôte non reconnu, HTTP simple ----------
# Garde l'accès existant par IP (http://<ip-du-vps>/...) fonctionnel —
# utile pour les tests et le diagnostic sans dépendre du DNS.
:80 {
	import api_routes
}
