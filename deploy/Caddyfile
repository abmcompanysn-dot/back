# ============================================================
# Passerelle externe — remplace l'URL WooCommerce côté frontend.
# Les routes Next.js app/api/* pointent ici ; le contrat JSON
# reste identique (généré à terme par grpc-gateway).
#
# Trois domaines nommés, HTTPS automatique (Let's Encrypt, géré par
# Caddy — nécessite les ports 80 ET 443 ouverts sur le VPS, et les
# enregistrements DNS déjà pointés vers l'IP du VPS avant le premier
# démarrage, sinon la validation ACME échoue) :
#   - origin.miadmarket.ca → toute l'API backend (bloc api_routes)
#   - kante.miadmarket.ca  → même VPS, uniquement le dashboard /admin
#   - img.miadmarket.ca    → même VPS, images produits/vendeurs (MinIO)
#
# Format multi-lignes obligatoire pour chaque bloc `handle { … }` —
# la syntaxe one-liner `handle /path { directive }` est rejetée par
# les versions récentes de Caddy 2 ("Unexpected next token after '{'
# on same line"), confirmé le 2026-08-24 sur caddy:2-alpine.
# ============================================================
{
	admin off
	email admin@miadmarket.ca
}

# ---------- Snippet réutilisable : toutes les routes API ----------
(api_routes) {
	encode zstd gzip

	# Catalogue — catalog-svc
	handle_path /catalog/* {
		reverse_proxy catalog-svc:8081
	}
	handle /products* {
		reverse_proxy catalog-svc:8081
	}
	handle /categories* {
		reverse_proxy catalog-svc:8081
	}
	handle /search/* {
		reverse_proxy catalog-svc:8081
	}
	handle /wishlist* {
		reverse_proxy catalog-svc:8081
	}
	handle /cart* {
		reverse_proxy catalog-svc:8081
	}
	# Avis produits (section avis complète : upload photo, vote "utile",
	# confirmation de livraison) — catalog-svc. AVANT /orders* car deux
	# endpoints avis sont sous /orders/{id}/... (can-review,
	# delivery-confirmation) mais servis par catalog-svc, pas order-svc.
	handle /reviews* {
		reverse_proxy catalog-svc:8081
	}
	@order_review path_regexp orev ^/orders/[^/]+/(can-review|delivery-confirmation)$
	handle @order_review {
		reverse_proxy catalog-svc:8081
	}

	# Boutiques & vendeurs — vendor-svc
	handle /stores* {
		reverse_proxy vendor-svc:8082
	}
	handle /vendor/* {
		reverse_proxy vendor-svc:8082
	}

	# Commandes — order-svc
	handle /orders* {
		reverse_proxy order-svc:8083
	}

	# Paiement (webhooks Stripe/PayDunya inclus) — payment-svc
	handle /payments/* {
		reverse_proxy payment-svc:8084
	}
	handle /payment-methods {
		reverse_proxy payment-svc:8084
	}
	# GET /pawapay/countries (liste pays/opérateurs pour le checkout mobile
	# money sans redirection, 2026-08-28) — jamais routé jusqu'ici malgré
	# son existence côté payment-svc (piège Caddyfile déjà documenté :
	# éditer ce fichier ne suffit pas, il faut aussi le redéployer).
	handle /pawapay/* {
		reverse_proxy payment-svc:8084
	}
	# GET /paydunya/softpay-providers (checkout mobile money sans
	# redirection, 2026-08-28) — même piège que /pawapay/* ci-dessus,
	# ajouté directement cette fois pour ne pas le redécouvrir en 404.
	handle /paydunya/* {
		reverse_proxy payment-svc:8084
	}

	# Livraison — shipping-svc (zone internationale + national Sénégal)
	handle /shipping-rates* {
		reverse_proxy shipping-svc:8085
	}
	handle /shipping-domestic/* {
		reverse_proxy shipping-svc:8085
	}
	handle /vendor-shipping-address {
		reverse_proxy shipping-svc:8085
	}
	handle /exchange-rates {
		reverse_proxy shipping-svc:8085
	}

	# Compte & auth — auth-svc
	handle /auth/* {
		reverse_proxy auth-svc:8086
	}
	handle /customer* {
		reverse_proxy auth-svc:8086
	}

	# Console d'administration (interface + API) — admin-svc
	handle /admin* {
		reverse_proxy admin-svc:8088
	}
	# Upload média (ouvert admin OU vendeur authentifié) — admin-svc
	handle /media/* {
		reverse_proxy admin-svc:8088
	}

	# Notifications (Kafka consumer, stats en lecture) + push FCM — notification-svc
	handle /notifications* {
		reverse_proxy notification-svc:8087
	}
	handle /push/* {
		reverse_proxy notification-svc:8087
	}

	# Emails transactionnels + webhooks entrants (Resend) — email-svc
	handle /emails* {
		reverse_proxy email-svc:8089
	}
	handle /email-templates* {
		reverse_proxy email-svc:8089
	}
	handle /webhooks/* {
		reverse_proxy email-svc:8089
	}

	# Tracking unifié + DHL — fulfillment-svc
	handle /shipments* {
		reverse_proxy fulfillment-svc:8090
	}
	handle /tracking/* {
		reverse_proxy fulfillment-svc:8090
	}
	handle /dhl/* {
		reverse_proxy fulfillment-svc:8090
	}

	# Coins/fidélité + représentants pays — loyalty-svc
	handle /coins* {
		reverse_proxy loyalty-svc:8091
	}
	handle /coupons* {
		reverse_proxy loyalty-svc:8091
	}
	handle /representative* {
		reverse_proxy loyalty-svc:8091
	}
	# Webhook entrant Twilio (réponses WhatsApp) — public comme /webhooks/*
	# ci-dessus, pas de secret dans l'URL (Twilio n'envoie pas d'en-tête
	# d'auth applicative standard sur ce type de webhook).
	handle /whatsapp/* {
		reverse_proxy loyalty-svc:8091
	}

	handle {
		respond 404 {
			body "{\"error\":{\"code\":\"not_found\",\"message\":\"route inconnue sur la passerelle\"}}"
		}
	}
}

# ---------- origin.miadmarket.ca : API backend complète ----------
origin.miadmarket.ca {
	import api_routes
}

# ---------- k8s.miadmarket.ca : Kubernetes Dashboard (surveillance cluster) ----------
# Installé le 2026-08-30 (demande du fondateur : voir l'état de santé de
# tous les pods/services depuis un navigateur). Le service dashboard
# écoute en HTTPS avec un certificat AUTO-SIGNÉ en interne (généré par
# le Dashboard lui-même) — tls_insecure_skip_verify ici concerne
# uniquement la connexion Caddy → pod à l'intérieur du cluster, PAS la
# connexion visiteur → Caddy (celle-ci reste un vrai certificat Let's
# Encrypt, HTTPS complet de bout en bout côté utilisateur).
#
# Protection ajoutée le 2026-08-30 (demande explicite du fondateur : un
# token cluster-admin statique sans 2FA, exposé publiquement, était jugé
# trop risqué) — mot de passe + code Google Authenticator devant TOUTE
# la page, via forward_auth vers auth-svc (mêmes identifiants admin que
# kante.miadmarket.ca, voir dashboardLoginHandler/verifyCookieHandler
# dans services/auth-svc/main.go). /login et /dashboard-login restent
# accessibles sans être déjà connecté (sinon impossible de se
# connecter) ; tout le reste exige le cookie miad_k8s_session valide.
k8s.miadmarket.ca {
	handle /login {
		root * /etc/caddy
		rewrite * /k8s-dashboard-login.html
		file_server
	}
	handle /dashboard-login {
		rewrite * /auth/dashboard-login
		reverse_proxy auth-svc:8086
	}
	handle {
		forward_auth auth-svc:8086 {
			uri /auth/verify-cookie
			# handle_response plutôt que handle_errors : forward_auth (qui
			# est un reverse_proxy déguisé) ne fait remonter son 401 comme
			# une VRAIE erreur Caddy (déclenchant handle_errors) que dans
			# certaines conditions peu fiables en pratique — testé le
			# 2026-08-30, le 401 passait tel quel au visiteur (JSON brut
			# d'auth-svc) sans jamais déclencher la redirection.
			@denied status 401
			handle_response @denied {
				redir * /login 302
			}
		}
		reverse_proxy kubernetes-dashboard.kubernetes-dashboard.svc.cluster.local:443 {
			transport http {
				tls_insecure_skip_verify
			}
		}
	}
}

# ---------- kante.miadmarket.ca : dashboard admin uniquement ----------
# /auth/admin/* ajouté car le webui admin (api.ts) suppose que /auth/*
# passe par la même origine que le dashboard — sans cette route, login
# et 2FA échouent en 404 (le domaine ne routait avant que /admin*).
kante.miadmarket.ca {
	redir / /admin/ 302
	handle /admin* {
		reverse_proxy admin-svc:8088
	}
	handle /auth/admin/* {
		reverse_proxy auth-svc:8086
	}
	handle {
		respond 404 {
			body "{\"error\":{\"code\":\"not_found\",\"message\":\"route inconnue — ce domaine ne sert que /admin\"}}"
		}
	}
}

# ---------- img.miadmarket.ca : images produits/vendeurs (MinIO) ----------
# Bucket "miad-media" public en lecture seule anonyme (écriture protégée
# par les credentials MinIO, jamais exposées côté client). rewrite ajoute
# le préfixe du bucket : img.miadmarket.ca/x.jpg → minio:9000/miad-media/x.jpg
img.miadmarket.ca {
	handle {
		reverse_proxy minio:9000 {
			rewrite /miad-media{uri}
		}
	}
}

# ---------- Repli : IP directe / nom d'hôte non reconnu, HTTP simple ----------
# Garde l'accès existant par IP (http://<ip-du-vps>/...) fonctionnel —
# utile pour les tests et le diagnostic sans dépendre du DNS.
:80 {
	import api_routes
}
